# Clerk Authentication
# Get these keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/queue
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/queue

# Database (MongoDB Atlas free tier, or local fallback to data/db.json)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/relay?retryWrites=true&w=majority

# Security & Encryption (AES-256-GCM for tokens at rest)
ENCRYPTION_KEY=your_secure_32_byte_secret_key_here

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Telegram Interactive Bot (Mobile 1-Tap Approvals & Inline Keyboard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Model Providers
# 1. Anthropic Claude (Primary: high quality structured JSON output)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Google Gemini (Fast fallback)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Social Media Publishing APIs (Optional: 1-tap copy fallback always available)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
